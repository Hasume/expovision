# Copy to .env before running `docker compose up --build`.
# Every value below is a local-development placeholder; replace secrets for any shared deployment.

# Host ports published by docker compose
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000

# URL of the API as seen by the browser (keep in sync with API_PORT)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Origins allowed by the API's CORS policy (keep in sync with WEB_PORT)
FRONTEND_ORIGINS=http://localhost:3000

# JWT signing secrets (use long random strings outside local development)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Administrator account created on API startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!

# The app does not send email. When true, POST /auth/password/request-reset returns the
# reset token in the response so the reset flow can be tried locally. Keep false elsewhere.
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=false

# Optional: AI assistance (homework coach, curator feedback drafts, summaries).
# Leave empty to run without AI; the related endpoints then answer 503 or use fallbacks.
GOOGLE_API_KEY=

# Optional: Kinescope video hosting for lesson videos and live webinars.
# Leave empty to run without it; webinars can still use a plain join URL.
KINESCOPE_API_TOKEN=
# VOD catalog project id (recordings, regular videos)
KINESCOPE_PROJECT_ID=
# Optional folder inside the VOD project where live recordings land
KINESCOPE_WEBINAR_RECORDINGS_FOLDER_ID=
# Live catalog project id (only needed when the account has several live projects)
KINESCOPE_LIVE_PROJECT_ID=
# Optional folder inside the live project used as parent_id for new live events
KINESCOPE_LIVE_PARENT_ID=
# Optional: when set, POST /webinar/hooks/kinescope requires the same value in the
# X-Expovision-Kinescope-Webhook-Secret header
KINESCOPE_WEBHOOK_SECRET=
