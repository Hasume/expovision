# Settings for running the API directly on the host (copy to backend-fastapi/.env).
# With docker compose these values come from the root .env instead.
# Note: the API stores uploads under /app/uploads, as laid out in the backend container.
ENVIRONMENT=development
PORT=4000
DATABASE_URL=postgresql://intensive:intensive@localhost:5432/intensive
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXP_MINUTES=30
JWT_REFRESH_EXP_DAYS=30
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
PASSWORD_RESET_RETURN_TOKEN_IN_RESPONSE=false

# Optional integrations; leave empty to disable
GOOGLE_API_KEY=
KINESCOPE_API_TOKEN=
KINESCOPE_PROJECT_ID=
